#!/usr/bin/env bash

set -euo pipefail

project_root="$(git rev-parse --show-toplevel)"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is required by the pre-commit hook." >&2
  echo "Install it from: https://github.com/gitleaks/gitleaks#installing" >&2
  exit 1
fi

git -C "$project_root" diff --cached --binary --no-ext-diff \
  | gitleaks stdin --redact --no-banner

exec "$project_root/scripts/check/check.sh"
