{
  "name": "cuke-dedup",
  "version": "0.15.0",
  "description": "Static analysis for duplicate and reusable Cucumber step definitions",
  "type": "module",
  "bin": {
    "cuke-dedup": "npm/bin/cuke-dedup.js"
  },
  "files": [
    "npm/bin/",
    "npm/lib/",
    "npm/prebuilt-targets.json",
    "README.md",
    "docs/",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test npm/test/*.test.mjs",
    "skills:check": "node scripts/check/check-agent-skills.mjs",
    "check:versions": "node scripts/check/check-release-version.mjs",
    "check:boundaries": "node scripts/check/check-language-boundary.mjs",
    "docs:check": "node scripts/check/check-docs-parity.mjs",
    "check:test": "node --test scripts/check/lib/*.test.mjs scripts/evaluate/lib/*.test.mjs scripts/release/lib/*.test.mjs scripts/check/preflight.test.mjs",
    "bump:version": "node scripts/release/bump-version.mjs",
    "release:compare": "node scripts/release/release-comparison.mjs",
    "pack:check": "npm pack --dry-run",
    "corpus:check": "node scripts/check/check-corpus.mjs",
    "corpus:evaluate": "node scripts/evaluate/corpus-evaluate.mjs",
    "corpus:distribution": "node scripts/evaluate/corpus-distribution.mjs",
    "memory:check": "node scripts/check/check-memory.mjs target/release/cuke-dedup",
    "duplication:check": "node scripts/check/check-duplication.mjs",
    "benchmark": "node scripts/benchmark/benchmark-analysis.mjs",
    "benchmark:check": "node scripts/check/check-benchmark-budget.mjs benchmark.json",
    "corpus:ruby": "node scripts/check/check-ruby-parity.mjs",
    "corpus:candidate-recall": "node scripts/evaluate/candidate-recall.mjs",
    "corpus:real": "node scripts/evaluate/real-corpus.mjs",
    "check:equivalence": "node scripts/check/check-output-equivalence.mjs",
    "check:ruby-keywords": "node scripts/check/check-ruby-step-keywords.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figueiredoluiz/cuke-dedup.git"
  },
  "homepage": "https://github.com/figueiredoluiz/cuke-dedup",
  "bugs": "https://github.com/figueiredoluiz/cuke-dedup/issues",
  "license": "MIT",
  "keywords": [
    "cucumber",
    "gherkin",
    "lint",
    "testing",
    "cli"
  ],
  "workspaces": [
    "npm/platforms/*"
  ],
  "optionalDependencies": {
    "cuke-dedup-darwin-arm64": "0.15.0",
    "cuke-dedup-darwin-x64": "0.15.0",
    "cuke-dedup-linux-arm64-gnu": "0.15.0",
    "cuke-dedup-linux-arm64-musl": "0.15.0",
    "cuke-dedup-linux-x64-gnu": "0.15.0",
    "cuke-dedup-linux-x64-musl": "0.15.0",
    "cuke-dedup-windows-arm64-msvc": "0.15.0",
    "cuke-dedup-windows-x64-msvc": "0.15.0"
  }
}
